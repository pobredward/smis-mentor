rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────
    // 헬퍼 함수
    // ──────────────────────────────────────────────────────────────

    // 로그인 여부
    function isAuthenticated() {
      return request.auth != null;
    }

    // 사용자 역할 가져오기 (Firestore 문서 기반)
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // 역할 체크 헬퍼
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    // 활성 사용자 (temp 아님)
    function isActiveUser() {
      return isAuthenticated() && getUserRole() in ['admin', 'mentor', 'foreign'];
    }

    // 캠프 운영진 (admin + active mentor/foreign)
    function isCampStaff() {
      return isAuthenticated() && getUserRole() in ['admin', 'mentor', 'foreign'];
    }

    // 본인 여부
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 필드 변경 감지: 변경되지 않아야 할 필드
    function fieldUnchanged(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys());
    }

    // ──────────────────────────────────────────────────────────────
    // users 컬렉션
    // 역할: admin(전체), 본인(읽기 + 제한적 수정), 비인증(가입/로그인용 쿼리만)
    //
    // [읽기 설계 배경]
    // 로그인·가입·소셜 로그인 플로우에서 Firebase Auth 세션이 없는 상태로
    // email / phoneNumber / status 기반 where 쿼리를 수행해야 한다.
    // - 단건 직접 읽기(get)는 본인 또는 admin만 허용한다.
    // - collection list 쿼리는 미인증 사용자도 허용한다.
    //   (클라이언트 SDK에서 where 조건 없는 전체 조회는 Rules 상 거부됨)
    // ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      // 캠프 참가 정보(여권·계좌 가림본 등) — 본인·관리자 읽기, 쓰기는 서버(/api/user/camp-profile)만
      match /private/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      allow get: if (
        // admin: 단건 직접 읽기 허용
        isAdmin() ||
        // 본인: 자신의 문서 단건 읽기
        isOwner(userId) ||
        // 인증된 캠프 운영진: 팀원 정보 조회 (평가·업무 등 협업 목적)
        isCampStaff()
      );

      allow list: if (
        // admin: 전체 목록 조회
        isAdmin() ||
        // 인증된 캠프 운영진: 팀원 목록 조회
        isCampStaff() ||
        // 로그인한 본인: 자기 이메일로 조회 (where('email','==',token.email) 형태만 통과)
        // 비로그인 조회(가입·로그인 중복 확인 등)는 /api/auth/lookup 이 Admin SDK로 대신한다.
        (
          isAuthenticated() &&
          'email' in request.auth.token &&
          resource.data.email == request.auth.token.email
        )
      );

      // 생성: 관리자(temp 계정 선생성)만. 가입 완료는 서버(/api/auth/complete-signup)가 Admin SDK 로 만든다
      // (클라이언트가 직접 만들면 role·jobExperiences 등 권한 필드를 스스로 넣을 수 있었다 — Phase 2 에서 차단)
      allow create: if (
        isAdmin() &&
        !('_firebaseAuthPassword' in request.resource.data) &&
        request.resource.data.keys().hasAll(['name', 'role', 'status']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 50
      );

      // 수정 권한
      allow update: if (
        // admin: 모든 필드 수정 가능 (역할 변경 포함)
        isAdmin() ||
        // 본인: 일반 프로필 수정 (role/status 변경 불가, 암호화 필드 직접 쓰기 금지)
        (
          isOwner(userId) &&
          fieldUnchanged('role') &&
          fieldUnchanged('status') &&
          fieldUnchanged('deletedAt') &&
          fieldUnchanged('deletedBy') &&
          // 암호화된 주민번호 뒷자리는 클라이언트에서 직접 쓰기 금지 (API Route만 허용)
          fieldUnchanged('rrnLastEncrypted') &&
          // 평문 주민번호 뒷자리는 더 이상 쓰지 않는다 (서버가 암호화해 rrnLastEncrypted 로 저장)
          fieldUnchanged('rrnLast') &&
          // 캠프 배정·평가 요약·관리자 임시 캠프는 admin/서버만 변경
          fieldUnchanged('jobExperiences') &&
          fieldUnchanged('jobCodeIds') &&
          fieldUnchanged('evaluationSummary') &&
          fieldUnchanged('adminTempActiveCamp') &&
          // 이메일은 Auth 와 동기화가 필요하므로 /api/user/change-email 로만 변경
          fieldUnchanged('email') &&
          // 평문 임시 비밀번호 저장 금지 (폐기됨)
          !('_firebaseAuthPassword' in request.resource.data) &&
          (!('name' in request.resource.data) || request.resource.data.name.size() <= 50)
        ) ||
        // 본인: 회원 탈퇴 (active → inactive 전환만 허용)
        // status: active → inactive 전환 + role/email/rrnLastEncrypted/deletedAt/deletedBy 변경 불가
        // 허용 변경 필드: status, name, originalEmail, deactivatedAt, updatedAt, profileImage, foreignTeacher
        (
          isOwner(userId) &&
          resource.data.status == 'active' &&
          request.resource.data.status == 'inactive' &&
          fieldUnchanged('role') &&
          fieldUnchanged('email') &&
          fieldUnchanged('rrnLastEncrypted') &&
          fieldUnchanged('deletedAt') &&
          fieldUnchanged('deletedBy') &&
          fieldUnchanged('jobExperiences') &&
          fieldUnchanged('jobCodeIds') &&
          fieldUnchanged('evaluationSummary')
        )
      );

      // 삭제: 관리자만 (temp 문서 정리는 가입 완료 서버 API 가 한다)
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // jobCodes 컬렉션 (캠프 코드)
    // 역할: admin(전체), 인증 사용자(읽기)
    // 참고: 회원가입 단계에서 미인증 상태로 jobCode 조회가 필요하므로 전체 읽기 허용
    // ──────────────────────────────────────────────────────────────
    match /jobCodes/{jobCodeId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // jobBoards 컬렉션 (채용 공고)
    // 역할: admin(전체), 전체 공개(읽기) - 비로그인 사용자도 공고 열람 가능
    // ──────────────────────────────────────────────────────────────
    match /jobBoards/{jobBoardId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // applicationHistories 컬렉션 (지원 내역)
    // 역할: admin(전체), 본인(자신의 지원 내역 읽기/취소)
    // ──────────────────────────────────────────────────────────────
    match /applicationHistories/{applicationId} {
      allow read: if (
        isAdmin() ||
        // 본인의 지원 내역만 읽기
        (isAuthenticated() && resource.data.refUserId == request.auth.uid)
      );
      allow create: if (
        isAuthenticated() &&
        // 본인 명의로만 지원 가능
        request.resource.data.refUserId == request.auth.uid &&
        // 필수 필드
        request.resource.data.keys().hasAll(['refUserId', 'refJobBoardId', 'applicationStatus', 'createdAt', 'updatedAt']) &&
        // 최초 상태는 'pending'만 가능
        request.resource.data.applicationStatus == 'pending' &&
        // 모집 중인 공고에만 지원 가능 (마감된 공고 지원 차단)
        get(/databases/$(database)/documents/jobBoards/$(request.resource.data.refJobBoardId)).data.status == 'active'
      );
      allow update: if (
        isAdmin() ||
        // 본인이 본인 지원을 'cancelled'로만 변경 가능 (pending 상태에서만)
        (
          isAuthenticated() &&
          resource.data.refUserId == request.auth.uid &&
          resource.data.applicationStatus == 'pending' &&
          request.resource.data.applicationStatus == 'cancelled' &&
          // refUserId, refJobBoardId 변경 불가
          fieldUnchanged('refUserId') &&
          fieldUnchanged('refJobBoardId')
        )
      );
      // 삭제: admin 또는 본인 (pending 상태만)
      allow delete: if (
        isAdmin() ||
        (
          isAuthenticated() &&
          resource.data.refUserId == request.auth.uid &&
          resource.data.applicationStatus == 'pending'
        )
      );
    }

    // ──────────────────────────────────────────────────────────────
    // evaluationCriteria 컬렉션 (평가 기준 템플릿)
    // 역할: admin(전체), 인증 사용자(읽기)
    // ──────────────────────────────────────────────────────────────
    match /evaluationCriteria/{criteriaId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // evaluations 컬렉션 (평가 데이터)
    // 역할: admin(전체), active 사용자(본인이 평가한 것 읽기/생성/삭제)
    // ──────────────────────────────────────────────────────────────
    match /evaluations/{evaluationId} {
      allow read: if (
        isAdmin() ||
        // 평가자 본인이 작성한 평가만 읽기
        (isActiveUser() && resource.data.evaluatorId == request.auth.uid)
      );
      allow create: if (
        isActiveUser() &&
        // 본인 명의로만 평가 생성
        request.resource.data.evaluatorId == request.auth.uid &&
        // 필수 필드
        request.resource.data.keys().hasAll(['refUserId', 'evaluationStage', 'criteriaTemplateId', 'evaluatorId', 'scores', 'totalScore', 'createdAt', 'updatedAt']) &&
        // 점수 범위 체크 (0~100)
        request.resource.data.totalScore is number &&
        request.resource.data.totalScore >= 0 &&
        request.resource.data.totalScore <= 100
      );
      allow update: if (
        isAdmin() ||
        // 평가자 본인만 수정 가능 (미완료 상태에서만)
        (
          isActiveUser() &&
          resource.data.evaluatorId == request.auth.uid &&
          resource.data.isFinalized == false &&
          fieldUnchanged('evaluatorId') &&
          fieldUnchanged('refUserId')
        )
      );
      // 평가자 본인도 미완료 상태 평가 삭제 가능
      allow delete: if (
        isAdmin() ||
        (
          isActiveUser() &&
          resource.data.evaluatorId == request.auth.uid &&
          resource.data.isFinalized == false
        )
      );
    }

    // ──────────────────────────────────────────────────────────────
    // reviews 컬렉션 (후기)
    // 역할: 전체 공개(읽기) - 비로그인 사용자도 후기 열람 가능, 본인(생성/수정/삭제)
    // ──────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if (
        isActiveUser() &&
        request.resource.data.author.id == request.auth.uid &&
        request.resource.data.keys().hasAll(['title', 'content', 'author', 'createdAt', 'updatedAt']) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() <= 10000
      );
      allow update: if (
        isAdmin() ||
        (
          isActiveUser() &&
          resource.data.author.id == request.auth.uid &&
          fieldUnchanged('author')
        )
      );
      allow delete: if isAdmin() || (isActiveUser() && resource.data.author.id == request.auth.uid);
    }

    // ──────────────────────────────────────────────────────────────
    // smsTemplates 컬렉션 (SMS 템플릿)
    // 역할: admin(전체), 캠프 스태프(읽기)
    // ──────────────────────────────────────────────────────────────
    match /smsTemplates/{templateId} {
      allow read: if isCampStaff();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // stSheetCache 컬렉션 (ST시트 캐시 - 학생 데이터)
    // 역할: admin(전체), 캠프 스태프(읽기)
    // 주의: 민감한 학생 개인정보 포함 (주민번호 등)
    // ──────────────────────────────────────────────────────────────
    match /stSheetCache/{campCode} {
      allow read: if isCampStaff();
      // 쓰기는 서버(Cloud Functions/Admin SDK)를 통해서만 가능
      allow write: if false;
    }

    // ──────────────────────────────────────────────────────────────
    // stSheetOverrides 컬렉션 (입소 레벨 테스트 등 admin 수동 수정값)
    // 재동기화(syncSTSheet)와 독립적으로 보존됨
    // ──────────────────────────────────────────────────────────────
    match /stSheetOverrides/{campCode}/students/{studentId} {
      allow read: if isCampStaff();
      allow write: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // familySTSheetCache 컬렉션 (가족 ST시트 캐시)
    // 역할: admin(전체), 캠프 스태프(읽기)
    // ──────────────────────────────────────────────────────────────
    match /familySTSheetCache/{campCode} {
      allow read: if isCampStaff();
      allow write: if false;
    }

    // ──────────────────────────────────────────────────────────────
    // stSheetSensitive 컬렉션 (학생·가족 주민번호 원본)
    // 클라이언트 접근 전면 차단 — 관리자도 /api/st/sensitive(감사 로그 기록)로만 조회
    // ──────────────────────────────────────────────────────────────
    match /stSheetSensitive/{campCode} {
      allow read, write: if false;
    }

    // ──────────────────────────────────────────────────────────────
    // campTasks 컬렉션 (캠프 업무)
    // 역할: admin(전체 CRUD), 캠프 스태프(읽기 + 완료 체크)
    // 한계: Firestore 규칙에서 배열 내부 요소(completions[*].userId)까지
    //       request.auth.uid와 비교할 수 없음. 타인 완료 체크 방지는
    //       Cloud Functions의 완료 처리 API를 통해 서버 사이드에서 검증할 것.
    // ──────────────────────────────────────────────────────────────
    match /campTasks/{taskId} {
      allow read: if isCampStaff();
      allow create: if isAdmin();
      // 업무 완료/취소 처리: completions 필드만 수정 가능, 1개 단위 변경만 허용
      allow update: if (
        isAdmin() ||
        (
          isCampStaff() &&
          // 완료 처리 및 업데이트 시간 외 필드 변경 불가
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completions', 'updatedAt']) &&
          // 완료 항목 수는 정확히 1개 증가 또는 1개 감소만 허용 (본인 완료/취소)
          (
            request.resource.data.completions.size() == resource.data.completions.size() + 1 ||
            request.resource.data.completions.size() == resource.data.completions.size() - 1
          )
        )
      );
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // personalTasks 컬렉션 (개인 업무)
    // 역할: 본인(ownerId)만 전체 CRUD — admin 포함 모든 역할(temp 포함)
    //
    // [read 설계 배경]
    // getPersonalTasksByGroupId, getPersonalTasksByDate 등 컬렉션 list 쿼리에서
    // where('ownerId', '==', uid) 조건으로 본인 데이터만 필터링한다.
    // Firestore list 쿼리는 규칙에서 resource.data를 사용할 수 없으므로
    // isAuthenticated() 수준에서 허용하되, 쿼리 자체에 ownerId 필터를 강제한다.
    // (실질적인 데이터 분리는 클라이언트 쿼리의 where('ownerId', '==', uid)로 보장)
    //
    // [delete 설계 배경]
    // deletePersonalTaskGroup은 groupId 기반 쿼리 후 배치 삭제를 수행한다.
    // temp 역할 사용자도 자신의 개인 업무를 삭제할 수 있어야 하므로
    // isActiveUser() 대신 isAuthenticated()를 사용한다.
    // ──────────────────────────────────────────────────────────────
    match /personalTasks/{taskId} {
      // list 쿼리도 본인 것만 — 쿼리에 where('ownerId', '==', uid) 가 있어야 통과한다
      // (2026-09 앱 업데이트 이후 배포: 구버전 앱의 groupId 단독 쿼리는 이 규칙에서 거부됨)
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow get: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if (
        isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.keys().hasAll(['ownerId', 'campCode', 'title', 'isCompleted', 'createdAt', 'updatedAt']) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 200
      );
      allow update: if (
        isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        // ownerId 변경 불가
        fieldUnchanged('ownerId')
      );
      // 본인(ownerId)만 삭제 가능 — temp 역할 포함
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // ──────────────────────────────────────────────────────────────
    // taskCategories 컬렉션 (업무 카테고리)
    // 역할: admin(전체), 인증 사용자(읽기)
    // ──────────────────────────────────────────────────────────────
    match /taskCategories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // campPages 컬렉션 (캠프 페이지)
    // 역할: admin(전체), 캠프 스태프(역할 기반 읽기 + 본인 역할 페이지 CRUD)
    // ──────────────────────────────────────────────────────────────
    match /campPages/{pageId} {
      allow read: if (
        isAdmin() ||
        // 캠프 스태프는 targetRole 기반 읽기 (필터는 화면에서)
        isCampStaff()
      );
      // 생성 · 수정 · 삭제는 관리자만 — 화면도 관리자에게만 편집 버튼이 있다
      allow create: if (
        isAdmin() &&
        request.resource.data.keys().hasAll(['jobCodeId', 'category', 'title', 'targetRole', 'content', 'order', 'createdAt', 'updatedAt']) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() <= 500000
      );
      allow update: if (
        isAdmin() &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() <= 500000
      );
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // generationResources 컬렉션 (기수별 리소스 링크)
    // 역할: admin(전체), 캠프 스태프(읽기 + 링크 추가/수정/삭제)
    // ──────────────────────────────────────────────────────────────
    match /generationResources/{jobCodeId} {
      allow read: if isCampStaff();
      // 링크 추가 · 수정 · 삭제는 관리자만 (화면도 관리자 전용)
      allow create, update: if isAdmin();
      // 삭제는 admin만 (전체 리소스 문서 삭제 보호)
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // lessonMaterials 컬렉션 (수업 자료)
    // 역할: admin(전체), 캠프 스태프(본인 자료 CRUD)
    // 각 사용자는 자신의 userId가 일치하는 자료만 생성/수정/삭제 가능
    // ──────────────────────────────────────────────────────────────
    match /lessonMaterials/{materialId} {
      allow read: if isCampStaff();
      // admin: 모든 자료 생성/수정/삭제
      // 캠프 스태프: 본인(userId) 자료만 생성/수정/삭제
      allow create: if (
        isAdmin() ||
        (isCampStaff() && request.resource.data.userId == request.auth.uid)
      );
      allow update: if (
        isAdmin() ||
        (isCampStaff() && resource.data.userId == request.auth.uid)
      );
      allow delete: if (
        isAdmin() ||
        (isCampStaff() && resource.data.userId == request.auth.uid)
      );

      // 서브컬렉션: sections
      // 부모 lessonMaterial의 소유자이거나 admin만 CRUD 가능
      match /sections/{sectionId} {
        allow read: if isCampStaff();
        allow create, update, delete: if (
          isAdmin() ||
          (
            isCampStaff() &&
            get(/databases/$(database)/documents/lessonMaterials/$(materialId)).data.userId == request.auth.uid
          )
        );
      }
    }

    // ──────────────────────────────────────────────────────────────
    // lessonMaterialTemplates 컬렉션 (수업 자료 템플릿)
    // 역할: admin(전체), 캠프 스태프(읽기)
    // ──────────────────────────────────────────────────────────────
    match /lessonMaterialTemplates/{templateId} {
      allow read: if isCampStaff();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // lessonPlans 컬렉션 (원어민 레슨플랜 — 앱에서 작성, 선생님 × 교재 한 문서)
    // 역할: 캠프 스태프(읽기), 본인(작성·수정·제출), admin(승인·수정 요청)
    // 본인은 승인(approved)으로 바꿀 수 없다 — 이미 승인된 문서를 고치는 건 허용(editedAfterApproval 표시)
    // ──────────────────────────────────────────────────────────────
    match /lessonPlans/{planId} {
      allow read: if isCampStaff();
      allow create: if (
        isAdmin() ||
        (
          isCampStaff() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status in ['draft', 'submitted']
        )
      );
      allow update: if (
        isAdmin() ||
        (
          isCampStaff() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == resource.data.userId &&
          (
            request.resource.data.status in ['draft', 'submitted'] ||
            request.resource.data.status == resource.data.status
          )
        )
      );
      allow delete: if (
        isAdmin() ||
        (isCampStaff() && resource.data.userId == request.auth.uid)
      );
    }

    // ──────────────────────────────────────────────────────────────
    // interviewSettings 컬렉션 (면접 설정/링크)
    // 역할: admin(전체), 인증 사용자(읽기)
    // ──────────────────────────────────────────────────────────────
    match /interviewSettings/{settingId} {
      allow read: if isAdmin(); // 면접 링크·일정·질문지 — 관리자 전용
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // appConfig 컬렉션 (앱 전역 설정)
    // 역할: admin(전체), 인증 사용자(읽기) - 버전 체크 등
    // ──────────────────────────────────────────────────────────────
    match /appConfig/{configId} {
      // 앱 버전 체크는 미인증 상태에서도 필요할 수 있음
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // campHomeMessages 컬렉션 (캠프별 홈 메시지)
    // 역할: admin(전체), 인증 사용자(읽기)
    // ──────────────────────────────────────────────────────────────
    match /campHomeMessages/{campCode} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // appSettings 컬렉션 (앱 전역 설정 — 캠프·기수와 무관)
    // 역할: 로그인 사용자(읽기), admin(전체 CRUD)
    // 용도: eslBooks (학년별 ESL 교재 리스트, L-Code → 교재 3권)
    // ──────────────────────────────────────────────────────────────
    match /appSettings/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // campSettings 컬렉션 (캠프별 설정)
    // 역할: admin(전체 CRUD), 캠프 스태프(읽기)
    // 용도: 임시데이터 on/off 설정 (useTemporaryData), sheetColumnMap
    // ──────────────────────────────────────────────────────────────
    // campRosters 컬렉션 (캠프 선생님 표 — 관리자가 동기화 리스트를 붙여넣어 저장)
    // 역할: 캠프 스태프(읽기), 쓰기는 서버(Admin SDK)만. 민감 정보(주민번호·여권·휴대폰)는 여기 두지 않는다
    match /campRosters/{jobCodeId} {
      allow read: if isCampStaff();
      allow write: if false;
    }

    match /campSettings/{campCode} {
      allow read: if isCampStaff();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // campTimetables 컬렉션 (앱 내부 시간표 — 캠프 × 그룹 × 일과 유형)
    // 역할: 캠프 스태프(읽기), admin(전체 CRUD)
    // 담임 이름은 저장하지 않고 classes[].classCode 로 users 에서 조인한다.
    // ──────────────────────────────────────────────────────────────
    match /campTimetables/{timetableId} {
      allow read: if isCampStaff();
      allow create, update, delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // stSheetFieldConfig 컬렉션 (캠프 타입별 동적 필드 설정)
    // 역할: admin(전체 CRUD), 캠프 스태프(읽기)
    // 용도: 학생 상세 화면의 섹션·필드 구성 (관리자 대시보드에서 설정)
    // ──────────────────────────────────────────────────────────────
    match /stSheetFieldConfig/{campType} {
      allow read: if isCampStaff();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // interviewDates 컬렉션 (면접 일정별 녹화 URL 등)
    // 역할: admin(전체 CRUD), 인증 사용자(읽기)
    // ──────────────────────────────────────────────────────────────
    match /interviewDates/{dateId} {
      allow read: if isAdmin(); // 면접 링크·일정·질문지 — 관리자 전용
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // interviewScripts 컬렉션 (면접 진행자 스크립트)
    // 역할: admin(전체 CRUD), 인증 사용자(읽기)
    // ──────────────────────────────────────────────────────────────
    match /interviewScripts/{scriptId} {
      allow read: if isAdmin(); // 면접 링크·일정·질문지 — 관리자 전용
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // userEvaluationSummaries 컬렉션 (사용자별 평가 요약)
    // 역할: admin(전체 CRUD)
    // 평가 생성/삭제 시 EvaluationService가 자동으로 upsert/delete
    // ──────────────────────────────────────────────────────────────
    match /userEvaluationSummaries/{userId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // userLocations 컬렉션 (실시간 위치 공유)
    // 역할: 캠프 스태프끼리 실시간 위치 공유 (토글 ON 시)
    // 문서 ID: {campCode}_{userId} 복합 키
    // ──────────────────────────────────────────────────────────────
    match /userLocations/{locationId} {
      // 캠프 운영진(admin/mentor/foreign)만 읽기 — 지원자·임시 계정은 위치 열람 불가
      allow read: if isCampStaff();
      // 본인 문서만 생성/수정 가능
      allow create, update: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.isSharing is bool
        && request.resource.data.lat is number
        && request.resource.data.lng is number;
      // 본인 문서만 삭제 가능
      allow delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // ──────────────────────────────────────────────────────────────
    // shareTokens 컬렉션 (지원자 공유 토큰)
    // 역할: 클라이언트 직접 접근 금지 (서버/Admin SDK 전용)
    // 주의: cleanup-expired API route는 반드시 Admin SDK를 사용해야 함
    //       (client SDK로 접근 시 이 규칙에 의해 Permission Denied 발생)
    // ──────────────────────────────────────────────────────────────
    match /shareTokens/{tokenId} {
      allow read, write: if false;
    }

    // ──────────────────────────────────────────────────────────────
    // auditLogs 컬렉션 (감사 로그)
    // 역할: admin(읽기), 쓰기는 서버 전용
    // ──────────────────────────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ──────────────────────────────────────────────────────────────
    // posts 컬렉션 (게시판)
    //
    // [접근 설계]
    // - 작성/읽기 권한: active 역할(mentor, foreign, admin)만 허용
    //   temp 역할(mentor_temp, foreign_temp)은 업무코드 없이 게시판 불가
    // - scope='dev': 작성자 본인 + admin만 읽기 가능
    // - scope 나머지(all/camp/group): active 캠프 스태프 전체 읽기
    //   (camp/group 범위 필터링은 클라이언트 쿼리에서 jobCodeId/groupId로 처리)
    //
    // [update 분리 설계]
    // - 좋아요 토글(likedBy, likeCount): 본인이 아닌 active 유저도 가능
    // - commentCount 증감: 댓글 생성/삭제 시 서비스에서 처리 → active 유저 허용
    // - 내용 수정(content, imageUrls): 작성자 본인 + 핵심 필드 불변 보장
    // ──────────────────────────────────────────────────────────────
    match /posts/{postId} {
      // dev 게시글: 본인 또는 admin만 읽기
      // 나머지 scope: active 캠프 스태프 전체 읽기
      allow read: if (
        isActiveUser() && (
          resource.data.scope != 'dev' ||
          isAdmin() ||
          resource.data.authorId == request.auth.uid
        )
      );

      // 새 게시글 작성: active 캠프 스태프 + 본인 명의
      allow create: if (
        isActiveUser() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'scope', 'authorId', 'authorName',
          'content', 'imageUrls',
          'likeCount', 'likedBy', 'commentCount',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.scope in ['all', 'camp', 'group', 'dev'] &&
        request.resource.data.content is string &&
        request.resource.data.content.size() <= 5000 &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.commentCount == 0
      );

      // 좋아요 토글 또는 commentCount 증감:
      // active 유저라면 likedBy/likeCount/commentCount/updatedAt 만 변경 허용
      allow update: if (
        isActiveUser() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likedBy', 'likeCount', 'commentCount', 'updatedAt'])
      );

      // 게시글 내용 수정: 작성자 본인만, 핵심 필드 불변
      allow update: if (
        isActiveUser() &&
        resource.data.authorId == request.auth.uid &&
        fieldUnchanged('authorId') &&
        fieldUnchanged('scope') &&
        fieldUnchanged('jobCodeId') &&
        fieldUnchanged('groupId') &&
        fieldUnchanged('likedBy') &&
        fieldUnchanged('likeCount') &&
        fieldUnchanged('commentCount') &&
        request.resource.data.content is string &&
        request.resource.data.content.size() <= 5000
      );

      // 게시글 삭제: 작성자 본인 또는 admin
      allow delete: if (
        isAdmin() ||
        (isActiveUser() && resource.data.authorId == request.auth.uid)
      );

      // 댓글 서브컬렉션
      match /comments/{commentId} {
        // dev 게시글 댓글: 본인 또는 admin만
        // 나머지: active 캠프 스태프 전체
        allow read: if (
          isActiveUser() && (
            get(/databases/$(database)/documents/posts/$(postId)).data.scope != 'dev' ||
            isAdmin() ||
            resource.data.authorId == request.auth.uid
          )
        );

        allow create: if (
          isActiveUser() &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.keys().hasAll([
            'parentId', 'authorId', 'authorName',
            'content', 'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.content is string &&
          request.resource.data.content.size() <= 1000
        );

        // 댓글 수정 / soft delete: 작성자 본인, 또는 admin(신고 처리·삭제) — 핵심 필드 불변
        allow update: if (
          (isAdmin() || (isActiveUser() && resource.data.authorId == request.auth.uid)) &&
          fieldUnchanged('authorId') &&
          fieldUnchanged('parentId')
        );

        // 댓글 삭제: 작성자 본인 또는 admin
        allow delete: if (
          isAdmin() ||
          (isActiveUser() && resource.data.authorId == request.auth.uid)
        );
      }
    }

    // ──────────────────────────────────────────────────────────────
    // 채팅 (카톡방 대체) — packages/shared/src/types/chat.ts
    //  chatRooms/{roomId}            방 — 서버(/api/chat/sync · /api/chat/dm, Admin SDK)만 만들고 사람을 바꾼다
    //    messages/{messageId}        방 사람이 본인 이름으로 쓴다. 고치기는 '모두에게서 삭제'만
    //    reads/{uid}                 마지막으로 본 시각 — 본인만
    //  chatUserState/{uid}           안 읽은 수 · 알림 끈 방 · 차단 — 본인 (안 읽은 수 더하기는 Functions)
    // 끼리 방(멘토끼리·원어민끼리)은 memberIds 에 관리자가 없으므로 관리자도 읽을 수 없다.
    // ──────────────────────────────────────────────────────────────
    function chatRoomDoc(roomId) {
      return get(/databases/$(database)/documents/chatRooms/$(roomId));
    }
    function isChatMember(roomId) {
      return isAuthenticated() && request.auth.uid in chatRoomDoc(roomId).data.memberIds;
    }

    match /chatRooms/{roomId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(roomId);
        // 보내기 — 글 · 사진/동영상(media) · 음성(voice, 파일 1개) · 투표(poll). 답장 · 멘션 · 조용히 보내기를 함께 붙일 수 있다
        allow create: if (
          isActiveUser() &&
          isChatMember(roomId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['senderId', 'senderName', 'kind', 'text', 'media', 'clientId', 'createdAt', 'replyTo', 'mentions', 'mentionAll', 'silent', 'poll']) &&
          request.resource.data.keys().hasAll(['senderId', 'senderName', 'kind', 'text', 'media', 'clientId', 'createdAt']) &&
          request.resource.data.kind in ['text', 'media', 'voice', 'poll'] &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.senderName is string &&
          request.resource.data.senderName.size() <= 60 &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 5000 &&
          request.resource.data.media is list &&
          request.resource.data.media.size() <= 10 &&
          request.resource.data.clientId is string &&
          request.resource.data.clientId.size() <= 64 &&
          (
            (request.resource.data.kind == 'text' && request.resource.data.text.size() > 0 && request.resource.data.media.size() == 0) ||
            (request.resource.data.kind == 'media' && request.resource.data.media.size() > 0) ||
            (request.resource.data.kind == 'voice' && request.resource.data.media.size() == 1) ||
            (
              request.resource.data.kind == 'poll' &&
              request.resource.data.media.size() == 0 &&
              request.resource.data.text.size() == 0 &&
              'poll' in request.resource.data &&
              request.resource.data.poll.question is string &&
              request.resource.data.poll.question.size() > 0 &&
              request.resource.data.poll.question.size() <= 300 &&
              request.resource.data.poll.options is list &&
              request.resource.data.poll.options.size() >= 2 &&
              request.resource.data.poll.options.size() <= 10
            )
          ) &&
          (!('poll' in request.resource.data) || request.resource.data.kind == 'poll') &&
          (!('replyTo' in request.resource.data) || (request.resource.data.replyTo is map && request.resource.data.replyTo.id is string)) &&
          (!('mentions' in request.resource.data) || (request.resource.data.mentions is list && request.resource.data.mentions.size() <= 100)) &&
          (!('silent' in request.resource.data) || request.resource.data.silent is bool) &&
          // @모두 — 캠프 방 · 그룹방의 매니저만
          (
            !('mentionAll' in request.resource.data) ||
            request.resource.data.mentionAll == false ||
            (chatRoomDoc(roomId).data.type != 'dm' && chatRoomDoc(roomId).data.memberInfo[request.auth.uid].kind == 'manager')
          )
        );
        // 모두에게서 삭제 — 보낸 사람 (관리자는 들어가 있는 방에서 신고 처리용으로)
        allow update: if (
          isChatMember(roomId) &&
          (resource.data.senderId == request.auth.uid || isAdmin()) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt', 'text', 'media']) &&
          request.resource.data.deleted == true &&
          request.resource.data.deletedAt == request.time &&
          request.resource.data.text == '' &&
          request.resource.data.media.size() == 0
        );
        // 글 고치기 — 보낸 사람, 글 메시지, 보낸 뒤 24시간 안
        allow update: if (
          isChatMember(roomId) &&
          resource.data.senderId == request.auth.uid &&
          resource.data.kind == 'text' &&
          resource.data.get('deleted', false) != true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 5000 &&
          request.resource.data.editedAt == request.time &&
          request.time < resource.data.createdAt + duration.value(24, 'h')
        );
        // 공감 — 방 사람 누구나, 자기 것만 (한 사람 하나)
        allow update: if (
          isChatMember(roomId) &&
          resource.data.get('deleted', false) != true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
          request.resource.data.reactions is map &&
          request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid]) &&
          (
            !(request.auth.uid in request.resource.data.reactions) ||
            request.resource.data.reactions[request.auth.uid] in ['check', 'heart', 'like', 'laugh', 'wow', 'sad']
          )
        );
        // 투표 — 방 사람 누구나, 자기 표만, 마감 전
        allow update: if (
          isChatMember(roomId) &&
          resource.data.kind == 'poll' &&
          resource.data.get('deleted', false) != true &&
          resource.data.get('pollClosed', false) != true &&
          (resource.data.poll.get('closesAt', null) == null || request.time < resource.data.poll.closesAt) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pollVotes']) &&
          request.resource.data.pollVotes is map &&
          request.resource.data.pollVotes.diff(resource.data.get('pollVotes', {})).affectedKeys().hasOnly([request.auth.uid]) &&
          (
            !(request.auth.uid in request.resource.data.pollVotes) ||
            (
              request.resource.data.pollVotes[request.auth.uid] is list &&
              request.resource.data.pollVotes[request.auth.uid].size() >= 1 &&
              request.resource.data.pollVotes[request.auth.uid].size() <= (resource.data.poll.multi == true ? 10 : 1)
            )
          )
        );
        // 투표 마감 — 만든 사람
        allow update: if (
          isChatMember(roomId) &&
          resource.data.senderId == request.auth.uid &&
          resource.data.kind == 'poll' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pollClosed']) &&
          request.resource.data.pollClosed == true
        );
        // 공지 '확인' — 지금 공지인 메시지에만, 자기 것만
        allow update: if (
          isChatMember(roomId) &&
          chatRoomDoc(roomId).data.get('notice', null) != null &&
          chatRoomDoc(roomId).data.notice.messageId == messageId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acks']) &&
          request.resource.data.acks is map &&
          request.resource.data.acks.diff(resource.data.get('acks', {})).affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.acks[request.auth.uid] == request.time
        );
        allow delete: if false;
      }

      match /reads/{uid} {
        allow read: if isChatMember(roomId);
        allow write: if (
          isOwner(uid) &&
          isChatMember(roomId) &&
          request.resource.data.keys().hasOnly(['uid', 'at']) &&
          request.resource.data.uid == uid &&
          request.resource.data.at == request.time
        );
      }
    }

    match /chatUserState/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if (
        isOwner(uid) &&
        request.resource.data.keys().hasOnly(['unread', 'muted', 'blocked', 'hidden', 'pinned', 'updatedAt']) &&
        (!('unread' in request.resource.data) || request.resource.data.unread is map) &&
        (!('muted' in request.resource.data) || request.resource.data.muted is map) &&
        (!('blocked' in request.resource.data) || request.resource.data.blocked is map) &&
        (!('hidden' in request.resource.data) || request.resource.data.hidden is map) &&
        (!('pinned' in request.resource.data) || request.resource.data.pinned is map)
      );
      allow delete: if false;
    }

    // 예약 메시지 — 보낸 사람만 보고 지운다. 그 시각에 Functions(chatSendScheduled)가 방에 보낸다 (글만)
    // 통화 (chatCalls/{callId}) — 서버(/api/chat/call, Admin SDK)만 쓴다.
    // 읽기: 그 방 사람 · 벨을 받는 사람 · 통화 안에 있는 사람. 목록은 '나에게 걸려 오는 통화'(invitedIds array-contains 나)만.
    match /chatCalls/{callId} {
      allow get: if isAuthenticated() && (
        request.auth.uid in resource.data.invitedIds ||
        request.auth.uid in resource.data.participantIds ||
        isChatMember(resource.data.roomId)
      );
      allow list: if isAuthenticated() && request.auth.uid in resource.data.invitedIds;
      allow write: if false;
    }

    match /chatScheduled/{scheduledId} {
      allow read, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      allow create: if (
        isActiveUser() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.roomId is string &&
        isChatMember(request.resource.data.roomId) &&
        request.resource.data.keys().hasOnly(['roomId', 'senderId', 'senderName', 'text', 'sendAt', 'createdAt', 'mentions', 'mentionAll', 'silent']) &&
        request.resource.data.keys().hasAll(['roomId', 'senderId', 'senderName', 'text', 'sendAt', 'createdAt']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 5000 &&
        request.resource.data.senderName is string &&
        request.resource.data.senderName.size() <= 60 &&
        request.resource.data.sendAt is timestamp &&
        request.resource.data.sendAt > request.time + duration.value(30, 's') &&
        request.resource.data.sendAt < request.time + duration.value(31, 'd') &&
        request.resource.data.createdAt == request.time &&
        (!('mentions' in request.resource.data) || (request.resource.data.mentions is list && request.resource.data.mentions.size() <= 100)) &&
        (!('silent' in request.resource.data) || request.resource.data.silent is bool) &&
        (
          !('mentionAll' in request.resource.data) ||
          request.resource.data.mentionAll == false ||
          (chatRoomDoc(request.resource.data.roomId).data.type != 'dm' && chatRoomDoc(request.resource.data.roomId).data.memberInfo[request.auth.uid].kind == 'manager')
        )
      );
      allow update: if false;
    }

    // ──────────────────────────────────────────────────────────────
    // reports 컬렉션 (커뮤니티 · 채팅 신고) — 앱스토어 UGC 정책
    // 작성: 로그인 사용자 본인 명의 / 열람·처리: admin
    // ──────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if isAdmin();
      // 채팅 메시지 신고 — 그 방 사람만, 같은 메시지는 한 번
      allow create: if (
        isActiveUser() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.targetType == 'chatMessage' &&
        request.resource.data.keys().hasAll(['targetType', 'roomId', 'messageId', 'targetAuthorId', 'reporterId', 'reason', 'status', 'createdAt']) &&
        request.resource.data.keys().hasOnly(['targetType', 'roomId', 'messageId', 'targetAuthorId', 'reporterId', 'reason', 'detail', 'excerpt', 'mediaCount', 'status', 'createdAt']) &&
        (!('detail' in request.resource.data) || (request.resource.data.detail is string && request.resource.data.detail.size() <= 500)) &&
        (!('excerpt' in request.resource.data) || (request.resource.data.excerpt is string && request.resource.data.excerpt.size() <= 500)) &&
        request.resource.data.reason in ['spam', 'abuse', 'sexual', 'privacy', 'other'] &&
        request.resource.data.status == 'open' &&
        isChatMember(request.resource.data.roomId) &&
        reportId == 'chatMessage_' + request.resource.data.roomId + '_' + request.resource.data.messageId + '_' + request.auth.uid
      );
      allow create: if (
        isActiveUser() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.keys().hasAll(['targetType', 'postId', 'targetAuthorId', 'reporterId', 'reason', 'status', 'createdAt']) &&
        request.resource.data.targetType in ['post', 'comment'] &&
        request.resource.data.reason in ['spam', 'abuse', 'sexual', 'privacy', 'other'] &&
        request.resource.data.status == 'open' &&
        reportId == request.resource.data.targetType + '_' +
          (request.resource.data.targetType == 'comment'
            ? request.resource.data.postId + '_' + request.resource.data.commentId
            : request.resource.data.postId) + '_' + request.auth.uid
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // patientRecords 컬렉션 (환자 기록)
    // 역할: 캠프 스태프(읽기/쓰기) — admin, mentor, foreign 모두 허용
    // 민감한 학생 건강 정보이므로 isCampStaff()로 제한
    // ──────────────────────────────────────────────────────────────
    match /patientRecords/{recordId} {
      // 읽기: 캠프 스태프 전체 (admin, mentor, foreign)
      allow read: if isCampStaff();

      // 생성: 캠프 스태프 + 필수 필드 검증
      allow create: if (
        isCampStaff() &&
        request.resource.data.keys().hasAll([
          'campCode', 'studentName', 'types',
          'symptom', 'progressStatus',
          'visitDate', 'recordedBy', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.studentName is string &&
        request.resource.data.studentName.size() <= 50 &&
        request.resource.data.symptom is string &&
        request.resource.data.symptom.size() <= 500
      );

      // 수정: 캠프 스태프 + 핵심 불변 필드 보호
      allow update: if (
        isAdmin() ||
        (
          isCampStaff() &&
          fieldUnchanged('campCode') &&
          fieldUnchanged('studentId') &&
          fieldUnchanged('createdAt') &&
          // 작성자를 바꾼 뒤 삭제하는 우회를 막는다
          fieldUnchanged('recordedById')
        )
      );

      // 삭제: admin 또는 본인이 기록한 것만
      allow delete: if (
        isAdmin() ||
        (isCampStaff() && resource.data.recordedById == request.auth.uid)
      );
    }

    // ──────────────────────────────────────────────────────────────
    // regularMedications 컬렉션 (상시약 — 약복용 명단 전용, 환자 기록 아님)
    // 문서 id 는 'rm_' 로 시작. 권한은 patientRecords 와 같게 캠프 스태프로 제한
    // ──────────────────────────────────────────────────────────────
    match /regularMedications/{docId} {
      allow read: if isCampStaff();
      allow create: if (
        isCampStaff() &&
        docId.matches('rm_.*') &&
        request.resource.data.keys().hasAll(['campCode', 'studentId', 'studentName', 'medicationSchedules', 'createdAt', 'updatedAt']) &&
        request.resource.data.studentName is string &&
        request.resource.data.studentName.size() <= 50
      );
      allow update: if (
        isAdmin() ||
        (
          isCampStaff() &&
          fieldUnchanged('campCode') &&
          fieldUnchanged('studentId') &&
          fieldUnchanged('createdAt') &&
          fieldUnchanged('recordedById')
        )
      );
      allow delete: if (
        isAdmin() ||
        (isCampStaff() && resource.data.recordedById == request.auth.uid)
      );
    }

    // ──────────────────────────────────────────────────────────────
    // 캠프 재고 (inventoryGroups / inventoryItems / inventoryMovements)
    // 역할: 관리자가 물품·그룹 등록/수정/삭제, 캠프 스태프는 조회 +
    //       환자 탭 약 복용 기록으로 인한 수량(stocks) 증감·이력 기록만 허용
    // ──────────────────────────────────────────────────────────────
    // 품목 마스터 (회사 공통) · 그룹(캠프별) · 그룹 패키지(회사 공통): 관리자만 쓰기
    match /inventoryItems/{itemId} {
      allow read: if isCampStaff();
      // 품목 이미지·영상(media) 포함 — 등록·변경·삭제 모두 관리자만
      allow create, update, delete: if isAdmin();
    }

    match /inventoryGroups/{groupId} {
      allow read: if isCampStaff();
      allow create, update, delete: if isAdmin();
    }

    match /inventoryPackages/{packageId} {
      allow read: if isCampStaff();
      allow create, update, delete: if isAdmin();
    }

    // 캠프별 수량 (문서 ID = campCode__itemId): 관리자만 직접 쓰기.
    // 약 복용에 따른 차감/복구는 서버(Cloud Function onPatientRecordWritten)가 원장 기준으로 처리
    match /inventoryStocks/{stockId} {
      allow read: if isCampStaff();
      allow create, update, delete: if isAdmin();
      // 스태프 누구나 세부 위치 적기
      allow update: if isCampStaff() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['locations', 'updatedAt']);
      // 스태프 누구나 '사용' — 한 그룹에서 lastUse.qty 만큼만 줄일 수 있음
      allow update: if isCampStaff() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stocks', 'lastUse', 'updatedAt']) &&
        request.resource.data.lastUse.byId == request.auth.uid &&
        request.resource.data.lastUse.qty is int &&
        request.resource.data.lastUse.qty > 0 &&
        request.resource.data.stocks.diff(resource.data.stocks).affectedKeys().hasOnly([request.resource.data.lastUse.groupId]) &&
        request.resource.data.stocks[request.resource.data.lastUse.groupId] ==
          resource.data.stocks.get(request.resource.data.lastUse.groupId, 0) - request.resource.data.lastUse.qty;
    }

    // 선생님 약 사용 기록 (환자 탭) — 캠프 스태프 조회, 본인 명의로 기록, 수정·삭제는 기록자·관리자
    // 재고 차감은 서버(/api/inventory/sync-dose, source=staff)가 원장으로 처리
    match /staffMedicationUses/{useId} {
      allow read: if isCampStaff();
      allow create: if isCampStaff() &&
        request.resource.data.recordedById == request.auth.uid &&
        request.resource.data.campCode is string &&
        request.resource.data.staffUserId is string &&
        request.resource.data.doses is list;
      allow update: if (isAdmin() || (isCampStaff() && resource.data.recordedById == request.auth.uid)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['symptom', 'note', 'doses', 'updatedAt']);
      allow delete: if isAdmin() || (isCampStaff() && resource.data.recordedById == request.auth.uid);
    }

    // ──────────────────────────────────────────────────────────────
    // 학생 용돈 장부 (학생 상세 모달 "용돈 관리")
    // 관리자·멘토·원어민 모두 기록·수정 가능, 삭제는 소프트 삭제(deleted)로만
    // ──────────────────────────────────────────────────────────────
    match /allowanceLedgers/{ledgerId} {
      allow read: if isCampStaff();
      allow create: if isCampStaff() &&
        request.resource.data.campCode is string &&
        request.resource.data.studentId is string &&
        ledgerId == request.resource.data.campCode + '_' + request.resource.data.studentId;
      allow update: if isCampStaff() &&
        fieldUnchanged('campCode') && fieldUnchanged('studentId');
      allow delete: if isAdmin();
    }

    match /allowanceTxns/{txnId} {
      allow read: if isCampStaff();
      allow create: if isCampStaff() &&
        request.resource.data.createdById == request.auth.uid &&
        request.resource.data.keys().hasAll(['campCode', 'studentId', 'currency', 'type', 'amount', 'category', 'date', 'createdBy', 'createdById', 'createdAt']) &&
        request.resource.data.type in ['spend', 'deposit'] &&
        request.resource.data.currency in ['KRW', 'SGD', 'MYR'] &&
        request.resource.data.amount is number && request.resource.data.amount > 0 &&
        !('deleted' in request.resource.data);
      allow update: if isCampStaff() &&
        fieldUnchanged('campCode') && fieldUnchanged('studentId') &&
        fieldUnchanged('createdById') && fieldUnchanged('createdBy') && fieldUnchanged('createdAt') &&
        fieldUnchanged('sourceKey') && fieldUnchanged('batchId') &&
        request.resource.data.type in ['spend', 'deposit'] &&
        request.resource.data.amount is number && request.resource.data.amount > 0;
      allow delete: if isAdmin();
    }

    // 학생 자유 메모 (반담당·방담당·그룹매니저) — ST 시트와 무관, 캠프 스태프 누구나 기록
    match /studentMemos/{memoId} {
      allow read: if isCampStaff();
      allow create: if isCampStaff() &&
        request.resource.data.campCode is string &&
        request.resource.data.studentId is string &&
        memoId == request.resource.data.campCode + '_' + request.resource.data.studentId;
      allow update: if isCampStaff() && fieldUnchanged('campCode') && fieldUnchanged('studentId');
      allow delete: if isAdmin();
    }

    // 학생 전자기기 (학생 상세 모달 "전자기기") — 잠금 해제 정보 포함, 캠프 스태프 전원 열람·기록
    match /studentDevices/{deviceId} {
      allow read: if isCampStaff();
      allow create: if isCampStaff() &&
        request.resource.data.createdById == request.auth.uid &&
        request.resource.data.keys().hasAll(['campCode', 'studentId', 'kind', 'model', 'lockType', 'location', 'createdBy', 'createdById', 'createdAt']) &&
        request.resource.data.location in ['student', 'unit', 'office', 'teacher', 'lent', 'returned'];
      allow update: if isCampStaff() &&
        fieldUnchanged('campCode') && fieldUnchanged('studentId') &&
        fieldUnchanged('createdById') && fieldUnchanged('createdAt') &&
        request.resource.data.location in ['student', 'unit', 'office', 'teacher', 'lent', 'returned'];
      allow delete: if isCampStaff();
    }

    // 약 복용 재고 원장 (서버 전용)
    match /inventoryDoseLedger/{recordId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 구매 요청: 캠프 스태프 누구나 올림(본인 명의). 본인은 '요청' 상태일 때만 수정·삭제,
    // 처리(구매 완료/반려)는 관리자
    match /supplyRequests/{requestId} {
      allow read: if isCampStaff();
      allow create: if (
        isCampStaff() &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.status == 'requested' &&
        request.resource.data.forType in ['student', 'mentor', 'camp'] &&
        request.resource.data.items is list &&
        !('buyerId' in request.resource.data) && !('done' in request.resource.data) && !('settlements' in request.resource.data) &&
        // 승인은 관리자만 — 새 요청은 '검토 중'으로 시작
        !('approvedAt' in request.resource.data) && !('approvedBy' in request.resource.data) && !('approvedById' in request.resource.data)
      );
      function supplyOpen(s) { return s in ['requested', 'onhold']; }
      function supplyChanged() { return request.resource.data.diff(resource.data).affectedKeys(); }
      allow update: if isAdmin() || (isCampStaff() && (
        // ① 작성자 — 진행 중일 때 내용 수정
        (
          resource.data.requesterId == request.auth.uid &&
          supplyOpen(resource.data.status) &&
          supplyChanged().hasOnly(['forType', 'studentId', 'studentName', 'studentClass', 'studentClassCode', 'classMentor', 'store', 'storeEtc', 'items', 'note', 'updatedAt']) &&
          request.resource.data.forType in ['student', 'mentor', 'camp'] &&
          request.resource.data.items is list
        ) ||
        // ③ 구매 담당 — 관리자가 승인한 요청만(요청별 지정, 없으면 캠프 기본 담당) — 품목별 구매 완료·취소 + 금액·송금 계좌
        (
          (
            resource.data.get('buyerId', null) == request.auth.uid ||
            (resource.data.get('buyerId', null) == null &&
              get(/databases/$(database)/documents/supplySettings/$(resource.data.campCode)).data.get('defaultBuyerId', null) == request.auth.uid)
          ) &&
          resource.data.status in ['requested', 'onhold', 'purchased'] &&
          request.resource.data.status in ['requested', 'onhold', 'purchased'] &&
          resource.data.get('stockApplied', false) != true &&
          resource.data.get('approvedAt', null) != null &&
          supplyChanged().hasOnly(['done', 'status', 'handledBy', 'handledAt', 'statusNote', 'holdUntil', 'amount', 'updatedAt'])
        ) ||
        // ④ 정산 체크 — 학생: 담임이 봉투에서 빼서 전달 / 선생님: 본인 송금 (누가 누르는지는 앱에서 확인)
        (
          resource.data.forType in ['student', 'mentor'] &&
          supplyChanged().hasOnly(['settlements', 'updatedAt'])
        )
      ));
      allow delete: if isAdmin() || (
        isCampStaff() &&
        resource.data.requesterId == request.auth.uid &&
        resource.data.status in ['requested', 'onhold'] &&
        // 구매 완료된 줄이 있으면 정산 근거가 사라지므로 삭제 불가
        resource.data.get('done', {}).size() == 0
      );
    }

    // 관리자 지정 품목 가이드 (쿠팡·학부모 청구 등, 회사 공통) — 조회 스태프, 변경 관리자
    match /supplyGuides/{guideId} {
      allow read: if isCampStaff();
      allow write: if isAdmin();
    }

    // 캠프별 구매 설정 (기본 구매 담당) — 조회 스태프, 변경 관리자
    match /supplySettings/{campCode} {
      allow read: if isCampStaff();
      allow write: if isAdmin();
    }

    match /purchaseItems/{purchaseId} {
      allow read: if isCampStaff();
      allow create, update, delete: if isAdmin();
    }

    // 분실물: 모든 캠프 스태프가 등록·조회·상태 변경, 삭제는 등록자 또는 관리자
    match /lostItems/{lostItemId} {
      allow read: if isCampStaff();
      allow create: if (
        isCampStaff() &&
        request.resource.data.reportedById == request.auth.uid &&
        request.resource.data.keys().hasAll(['campCode', 'name', 'foundDate', 'status', 'media', 'reportedBy', 'reportedById', 'createdAt', 'updatedAt'])
      );
      allow update: if (
        isCampStaff() &&
        fieldUnchanged('campCode') &&
        fieldUnchanged('reportedById') &&
        fieldUnchanged('reportedBy') &&
        fieldUnchanged('createdAt') &&
        fieldUnchanged('kind') &&
        // 알림 1회 발송 기록은 서버만 쓴다 (지우고 다시 보내기 방지)
        fieldUnchanged('notifiedAt') &&
        fieldUnchanged('matchNotifiedAt') &&
        // 첨부는 누구나 더할 수 있지만, 빼는 건 등록자 · 관리자만
        (
          !('media' in request.resource.data.diff(resource.data).affectedKeys()) ||
          request.resource.data.media.size() >= resource.data.media.size() ||
          resource.data.reportedById == request.auth.uid ||
          isAdmin()
        )
      );
      allow delete: if isAdmin() || (isCampStaff() && resource.data.reportedById == request.auth.uid);
    }

    match /inventoryMovements/{movementId} {
      allow read: if isCampStaff();
      // 관리자(입고·조정·실사)만 직접 기록, 약 복용 내역은 서버가 기록
      allow create: if (
        isAdmin() &&
        request.resource.data.keys().hasAll(['campCode', 'itemId', 'groupId', 'delta', 'reason', 'at', 'by']) &&
        request.resource.data.delta is number
      );
      // 스태프: 본인 이름의 '사용' 기록 (감소만)
      allow create: if (
        isCampStaff() &&
        request.resource.data.keys().hasAll(['campCode', 'itemId', 'groupId', 'delta', 'reason', 'at', 'by', 'byId']) &&
        request.resource.data.reason == 'use' &&
        request.resource.data.byId == request.auth.uid &&
        request.resource.data.delta is number &&
        request.resource.data.delta < 0
      );
      // 입출고 기록은 감사용 — 누구도 고치거나 지우지 않는다 (서버 Admin SDK 는 규칙 밖)
      allow update, delete: if false;
    }

    // ──────────────────────────────────────────────────────────────
    // 소셜 신원 연결표 · 속도 제한 — 서버(Admin SDK) 전용
    // authIdentities/{제공자}_{제공자 id} → { uid } : /api/auth/social* 만 쓴다 (web lib/authIdentity.ts)
    // rateLimits : /api/auth/lookup 의 IP 별 횟수
    // ──────────────────────────────────────────────────────────────
    match /authIdentities/{id} {
      allow read, write: if false;
    }
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // ──────────────────────────────────────────────────────────────
    // 기본 거부 (명시되지 않은 모든 컬렉션)
    // ──────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
