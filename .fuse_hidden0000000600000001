[debug] [2026-09-22T12:01:43.518Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/smis-mentor/rulesets {"name":"projects/smis-mentor/rulesets/10481a9f-5f4b-4283-bdb9-77d0a4b34193","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // ──────────────────────────────────────────────────────────────\n    // 헬퍼 함수\n    // ──────────────────────────────────────────────────────────────\n\n    // 로그인 여부\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    // 사용자 역할 가져오기 (Firestore 문서 기반)\n    function getUserRole() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;\n    }\n\n    // 역할 체크 헬퍼\n    function isAdmin() {\n      return isAuthenticated() && getUserRole() == 'admin';\n    }\n\n    // 활성 사용자 (temp 아님)\n    function isActiveUser() {\n      return isAuthenticated() && getUserRole() in ['admin', 'mentor', 'foreign'];\n    }\n\n    // 캠프 운영진 (admin + active mentor/foreign)\n    function isCampStaff() {\n      return isAuthenticated() && getUserRole() in ['admin', 'mentor', 'foreign'];\n    }\n\n    // 본인 여부\n    function isOwner(uid) {\n      return isAuthenticated() && request.auth.uid == uid;\n    }\n\n    // 필드 변경 감지: 변경되지 않아야 할 필드\n    function fieldUnchanged(field) {\n      return !(field in request.resource.data.diff(resource.data).affectedKeys());\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // users 컬렉션\n    // 역할: admin(전체), 본인(읽기 + 제한적 수정), 비인증(가입/로그인용 쿼리만)\n    //\n    // [읽기 설계 배경]\n    // 로그인·가입·소셜 로그인 플로우에서 Firebase Auth 세션이 없는 상태로\n    // email / phoneNumber / status 기반 where 쿼리를 수행해야 한다.\n    // - 단건 직접 읽기(get)는 본인 또는 admin만 허용한다.\n    // - collection list 쿼리는 미인증 사용자도 허용한다.\n    //   (클라이언트 SDK에서 where 조건 없는 전체 조회는 Rules 상 거부됨)\n    // ──────────────────────────────────────────────────────────────\n    match /users/{userId} {\n      allow get: if (\n        // admin: 단건 직접 읽기 허용\n        isAdmin() ||\n        // 본인: 자신의 문서 단건 읽기\n        isOwner(userId) ||\n        // 인증된 캠프 운영진: 팀원 정보 조회 (평가·업무 등 협업 목적)\n        isCampStaff()\n      );\n\n      allow list: if (\n        // admin: 전체 목록 조회\n        isAdmin() ||\n        // 인증된 캠프 운영진: 팀원 목록 조회\n        isCampStaff() ||\n        // 미인증 포함 모든 사용자: 로그인·가입 플로우의 중복 확인 및 계정 조회\n        // (where 조건 없는 전체 조회는 Firestore가 클라이언트 SDK 레벨에서 차단됨)\n        true\n      );\n\n      // 신규 가입 시 생성\n      // Case 1: temp 계정 선생성 (admin이 미리 만들어 둔 경우)\n      // Case 2: 가입 완료 시 active 계정 직접 생성 (Firebase Auth UID = userId)\n      allow create: if (\n        // 필수 필드 존재 확인\n        request.resource.data.keys().hasAll(['name', 'email', 'role', 'status', 'agreedTerms', 'agreedPersonal']) &&\n        // 이름 길이 제한 (DoS 방지)\n        request.resource.data.name is string &&\n        request.resource.data.name.size() <= 50 &&\n        // 이메일 길이 제한\n        request.resource.data.email is string &&\n        request.resource.data.email.size() <= 200 &&\n        // 허용 역할\n        request.resource.data.role in ['mentor_temp', 'foreign_temp', 'mentor', 'foreign'] &&\n        // 역할에 따른 status 일관성\n        // - admin이 미리 선생성한 temp 계정: *_temp + temp\n        // - 가입 완료 즉시 활성화: mentor_temp/foreign/mentor + active\n        //   (mentor_temp + active: 멘토는 가입 후 admin 승격 대기)\n        //   (foreign + active: 원어민은 가입 즉시 활성)\n        (\n          (request.resource.data.role in ['mentor_temp', 'foreign_temp'] && request.resource.data.status == 'temp') ||\n          (request.resource.data.role == 'mentor_temp' && request.resource.data.status == 'active') ||\n          (request.resource.data.role in ['mentor', 'foreign'] && request.resource.data.status == 'active')\n        )\n      );\n\n      // 수정 권한\n      allow update: if (\n        // admin: 모든 필드 수정 가능 (역할 변경 포함)\n        isAdmin() ||\n        // 본인: 일반 프로필 수정 (role/status 변경 불가, 암호화 필드 직접 쓰기 금지)\n        (\n          isOwner(userId) &&\n          fieldUnchanged('role') &&\n          fieldUnchanged('status') &&\n          fieldUnchanged('deletedAt') &&\n          fieldUnchanged('deletedBy') &&\n          // 암호화된 주민번호 뒷자리는 클라이언트에서 직접 쓰기 금지 (API Route만 허용)\n          fieldUnchanged('rrnLastEncrypted') &&\n          (!('name' in request.resource.data) || request.resource.data.name.size() <= 50) &&\n          (!('email' in request.resource.data) || request.resource.data.email.size() <= 200)\n        ) ||\n        // 본인: 회원 탈퇴 (active → inactive 전환만 허용)\n        // status: active → inactive 전환 + role/email/rrnLastEncrypted/deletedAt/deletedBy 변경 불가\n        // 허용 변경 필드: status, name, originalEmail, deactivatedAt, updatedAt, profileImage, foreignTeacher\n        (\n          isOwner(userId) &&\n          resource.data.status == 'active' &&\n          request.resource.data.status == 'inactive' &&\n          fieldUnchanged('role') &&\n          fieldUnchanged('email') &&\n          fieldUnchanged('rrnLastEncrypted') &&\n          fieldUnchanged('deletedAt') &&\n          fieldUnchanged('deletedBy')\n        ) ||\n        // 가입 완료 시 temp→active 승격 (Firebase Auth UID로 인증된 상태)\n        // role: *_temp → mentor/foreign, status: temp → active 변경 허용\n        (\n          isOwner(userId) &&\n          resource.data.status == 'temp' &&\n          request.resource.data.status == 'active' &&\n          resource.data.role in ['mentor_temp', 'foreign_temp'] &&\n          request.resource.data.role in ['mentor', 'foreign'] &&\n          fieldUnchanged('deletedAt') &&\n          fieldUnchanged('deletedBy') &&\n          // 가입 완료 시에도 암호화 필드 직접 쓰기 금지\n          fieldUnchanged('rrnLastEncrypted') &&\n          (!('name' in request.resource.data) || request.resource.data.name.size() <= 50) &&\n          (!('email' in request.resource.data) || request.resource.data.email.size() <= 200)\n        )\n      );\n\n      // 삭제: admin 또는 가입 플로우에서 본인이 소유한 temp 문서 삭제\n      // (소셜 가입 시 임시 문서를 새 UID 문서로 교체하는 과정)\n      // isOwner(userId): Auth UID = 문서 ID인 경우 (temp 활성화 직후)\n      // resource.data.userId == request.auth.uid: Firestore userId 필드 기준 본인 확인\n      allow delete: if (\n        isAdmin() ||\n        (\n          isAuthenticated() &&\n          resource.data.status == 'temp' &&\n          resource.data.role in ['mentor_temp', 'foreign_temp'] &&\n          (\n            isOwner(userId) ||\n            resource.data.userId == request.auth.uid\n          )\n        )\n      );\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // jobCodes 컬렉션 (캠프 코드)\n    // 역할: admin(전체), 인증 사용자(읽기)\n    // 참고: 회원가입 단계에서 미인증 상태로 jobCode 조회가 필요하므로 전체 읽기 허용\n    // ──────────────────────────────────────────────────────────────\n    match /jobCodes/{jobCodeId} {\n      allow read: if true;\n      allow create, update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // jobBoards 컬렉션 (채용 공고)\n    // 역할: admin(전체), 전체 공개(읽기) - 비로그인 사용자도 공고 열람 가능\n    // ──────────────────────────────────────────────────────────────\n    match /jobBoards/{jobBoardId} {\n      allow read: if true;\n      allow create, update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // applicationHistories 컬렉션 (지원 내역)\n    // 역할: admin(전체), 본인(자신의 지원 내역 읽기/취소)\n    // ──────────────────────────────────────────────────────────────\n    match /applicationHistories/{applicationId} {\n      allow read: if (\n        isAdmin() ||\n        // 본인의 지원 내역만 읽기\n        (isAuthenticated() && resource.data.refUserId == request.auth.uid)\n      );\n      allow create: if (\n        isAuthenticated() &&\n        // 본인 명의로만 지원 가능\n        request.resource.data.refUserId == request.auth.uid &&\n        // 필수 필드\n        request.resource.data.keys().hasAll(['refUserId', 'refJobBoardId', 'applicationStatus', 'createdAt', 'updatedAt']) &&\n        // 최초 상태는 'pending'만 가능\n        request.resource.data.applicationStatus == 'pending'\n      );\n      allow update: if (\n        isAdmin() ||\n        // 본인이 본인 지원을 'cancelled'로만 변경 가능 (pending 상태에서만)\n        (\n          isAuthenticated() &&\n          resource.data.refUserId == request.auth.uid &&\n          resource.data.applicationStatus == 'pending' &&\n          request.resource.data.applicationStatus == 'cancelled' &&\n          // refUserId, refJobBoardId 변경 불가\n          fieldUnchanged('refUserId') &&\n          fieldUnchanged('refJobBoardId')\n        )\n      );\n      // 삭제: admin 또는 본인 (pending 상태만)\n      allow delete: if (\n        isAdmin() ||\n        (\n          isAuthenticated() &&\n          resource.data.refUserId == request.auth.uid &&\n          resource.data.applicationStatus == 'pending'\n        )\n      );\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // evaluationCriteria 컬렉션 (평가 기준 템플릿)\n    // 역할: admin(전체), 인증 사용자(읽기)\n    // ──────────────────────────────────────────────────────────────\n    match /evaluationCriteria/{criteriaId} {\n      allow read: if isAuthenticated();\n      allow create, update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // evaluations 컬렉션 (평가 데이터)\n    // 역할: admin(전체), active 사용자(본인이 평가한 것 읽기/생성/삭제)\n    // ──────────────────────────────────────────────────────────────\n    match /evaluations/{evaluationId} {\n      allow read: if (\n        isAdmin() ||\n        // 평가자 본인이 작성한 평가만 읽기\n        (isActiveUser() && resource.data.evaluatorId == request.auth.uid)\n      );\n      allow create: if (\n        isActiveUser() &&\n        // 본인 명의로만 평가 생성\n        request.resource.data.evaluatorId == request.auth.uid &&\n        // 필수 필드\n        request.resource.data.keys().hasAll(['refUserId', 'evaluationStage', 'criteriaTemplateId', 'evaluatorId', 'scores', 'totalScore', 'createdAt', 'updatedAt']) &&\n        // 점수 범위 체크 (0~100)\n        request.resource.data.totalScore is number &&\n        request.resource.data.totalScore >= 0 &&\n        request.resource.data.totalScore <= 100\n      );\n      allow update: if (\n        isAdmin() ||\n        // 평가자 본인만 수정 가능 (미완료 상태에서만)\n        (\n          isActiveUser() &&\n          resource.data.evaluatorId == request.auth.uid &&\n          resource.data.isFinalized == false &&\n          fieldUnchanged('evaluatorId') &&\n          fieldUnchanged('refUserId')\n        )\n      );\n      // 평가자 본인도 미완료 상태 평가 삭제 가능\n      allow delete: if (\n        isAdmin() ||\n        (\n          isActiveUser() &&\n          resource.data.evaluatorId == request.auth.uid &&\n          resource.data.isFinalized == false\n        )\n      );\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // reviews 컬렉션 (후기)\n    // 역할: 전체 공개(읽기) - 비로그인 사용자도 후기 열람 가능, 본인(생성/수정/삭제)\n    // ──────────────────────────────────────────────────────────────\n    match /reviews/{reviewId} {\n      allow read: if true;\n      allow create: if (\n        isActiveUser() &&\n        request.resource.data.author.id == request.auth.uid &&\n        request.resource.data.keys().hasAll(['title', 'content', 'author', 'createdAt', 'updatedAt']) &&\n        request.resource.data.title is string &&\n        request.resource.data.title.size() <= 200 &&\n        request.resource.data.content is string &&\n        request.resource.data.content.size() <= 10000\n      );\n      allow update: if (\n        isAdmin() ||\n        (\n          isActiveUser() &&\n          resource.data.author.id == request.auth.uid &&\n          fieldUnchanged('author')\n        )\n      );\n      allow delete: if isAdmin() || (isActiveUser() && resource.data.author.id == request.auth.uid);\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // smsTemplates 컬렉션 (SMS 템플릿)\n    // 역할: admin(전체), 캠프 스태프(읽기)\n    // ──────────────────────────────────────────────────────────────\n    match /smsTemplates/{templateId} {\n      allow read: if isCampStaff();\n      allow create, update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // stSheetCache 컬렉션 (ST시트 캐시 - 학생 데이터)\n    // 역할: admin(전체), 캠프 스태프(읽기)\n    // 주의: 민감한 학생 개인정보 포함 (주민번호 등)\n    // ──────────────────────────────────────────────────────────────\n    match /stSheetCache/{campCode} {\n      allow read: if isCampStaff();\n      // 쓰기는 서버(Cloud Functions/Admin SDK)를 통해서만 가능\n      allow write: if false;\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // stSheetOverrides 컬렉션 (입소 레벨 테스트 등 admin 수동 수정값)\n    // 재동기화(syncSTSheet)와 독립적으로 보존됨\n    // ──────────────────────────────────────────────────────────────\n    match /stSheetOverrides/{campCode}/students/{studentId} {\n      allow read: if isCampStaff();\n      allow write: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // familySTSheetCache 컬렉션 (가족 ST시트 캐시)\n    // 역할: admin(전체), 캠프 스태프(읽기)\n    // ──────────────────────────────────────────────────────────────\n    match /familySTSheetCache/{campCode} {\n      allow read: if isCampStaff();\n      allow write: if false;\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // campTasks 컬렉션 (캠프 업무)\n    // 역할: admin(전체 CRUD), 캠프 스태프(읽기 + 완료 체크)\n    // 한계: Firestore 규칙에서 배열 내부 요소(completions[*].userId)까지\n    //       request.auth.uid와 비교할 수 없음. 타인 완료 체크 방지는\n    //       Cloud Functions의 완료 처리 API를 통해 서버 사이드에서 검증할 것.\n    // ──────────────────────────────────────────────────────────────\n    match /campTasks/{taskId} {\n      allow read: if isCampStaff();\n      allow create: if isAdmin();\n      // 업무 완료/취소 처리: completions 필드만 수정 가능, 1개 단위 변경만 허용\n      allow update: if (\n        isAdmin() ||\n        (\n          isCampStaff() &&\n          // 완료 처리 및 업데이트 시간 외 필드 변경 불가\n          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completions', 'updatedAt']) &&\n          // 완료 항목 수는 정확히 1개 증가 또는 1개 감소만 허용 (본인 완료/취소)\n          (\n            request.resource.data.completions.size() == resource.data.completions.size() + 1 ||\n            request.resource.data.completions.size() == resource.data.completions.size() - 1\n          )\n        )\n      );\n      allow delete: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // personalTasks 컬렉션 (개인 업무)\n    // 역할: 본인(ownerId)만 전체 CRUD — admin 포함 모든 역할(temp 포함)\n    //\n    // [read 설계 배경]\n    // getPersonalTasksByGroupId, getPersonalTasksByDate 등 컬렉션 list 쿼리에서\n    // where('ownerId', '==', uid) 조건으로 본인 데이터만 필터링한다.\n    // Firestore list 쿼리는 규칙에서 resource.data를 사용할 수 없으므로\n    // isAuthenticated() 수준에서 허용하되, 쿼리 자체에 ownerId 필터를 강제한다.\n    // (실질적인 데이터 분리는 클라이언트 쿼리의 where('ownerId', '==', uid)로 보장)\n    //\n    // [delete 설계 배경]\n    // deletePersonalTaskGroup은 groupId 기반 쿼리 후 배치 삭제를 수행한다.\n    // temp 역할 사용자도 자신의 개인 업무를 삭제할 수 있어야 하므로\n    // isActiveUser() 대신 isAuthenticated()를 사용한다.\n    // ──────────────────────────────────────────────────────────────\n    match /personalTasks/{taskId} {\n      // list 쿼리 허용 (where ownerId == uid 조건 강제는 클라이언트에서 보장)\n      // getDoc 단건 조회는 resource.data.ownerId 비교로 본인만 허용\n      allow list: if isAuthenticated();\n      allow get: if isAuthenticated() && resource.data.ownerId == request.auth.uid;\n      allow create: if (\n        isAuthenticated() &&\n        request.resource.data.ownerId == request.auth.uid &&\n        request.resource.data.keys().hasAll(['ownerId', 'campCode', 'title', 'isCompleted', 'createdAt', 'updatedAt']) &&\n        request.resource.data.title is string &&\n        request.resource.data.title.size() <= 200\n      );\n      allow update: if (\n        isAuthenticated() &&\n        resource.data.ownerId == request.auth.uid &&\n        // ownerId 변경 불가\n        fieldUnchanged('ownerId')\n      );\n      // 본인(ownerId)만 삭제 가능 — temp 역할 포함\n      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // taskCategories 컬렉션 (업무 카테고리)\n    // 역할: admin(전체), 인증 사용자(읽기)\n    // ──────────────────────────────────────────────────────────────\n    match /taskCategories/{categoryId} {\n      allow read: if isAuthenticated();\n      allow create, update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // campPages 컬렉션 (캠프 페이지)\n    // 역할: admin(전체), 캠프 스태프(역할 기반 읽기 + 본인 역할 페이지 CRUD)\n    // ──────────────────────────────────────────────────────────────\n    match /campPages/{pageId} {\n      allow read: if (\n        isAdmin() ||\n        // 캠프 스태프는 targetRole 기반 읽기\n        isCampStaff()\n      );\n      allow create: if (\n        isAdmin() ||\n        (\n          isCampStaff() &&\n          request.resource.data.keys().hasAll(['jobCodeId', 'category', 'title', 'targetRole', 'content', 'order', 'createdAt', 'updatedAt']) &&\n          request.resource.data.title is string &&\n          request.resource.data.title.size() <= 200 &&\n          request.resource.data.content is string &&\n          request.resource.data.content.size() <= 500000\n        )\n      );\n      allow update: if (\n        isAdmin() ||\n        (\n          isCampStaff() &&\n          request.resource.data.title is string &&\n          request.resource.data.title.size() <= 200 &&\n          request.resource.data.content is string &&\n          request.resource.data.content.size() <= 500000 &&\n          // jobCodeId, targetRole 변경 불가 (본인 캠프/역할의 페이지만 수정)\n          fieldUnchanged('jobCodeId') &&\n          fieldUnchanged('targetRole')\n        )\n      );\n      allow delete: if isAdmin() || isCampStaff();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // generationResources 컬렉션 (기수별 리소스 링크)\n    // 역할: admin(전체), 캠프 스태프(읽기 + 링크 추가/수정/삭제)\n    // ──────────────────────────────────────────────────────────────\n    match /generationResources/{jobCodeId} {\n      allow read: if isCampStaff();\n      // 캠프 스태프도 링크 추가/수정/삭제 가능 (링크 관리 기능)\n      allow create, update: if isCampStaff();\n      // 삭제는 admin만 (전체 리소스 문서 삭제 보호)\n      allow delete: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // lessonMaterials 컬렉션 (수업 자료)\n    // 역할: admin(전체), 캠프 스태프(본인 자료 CRUD)\n    // 각 사용자는 자신의 userId가 일치하는 자료만 생성/수정/삭제 가능\n    // ──────────────────────────────────────────────────────────────\n    match /lessonMaterials/{materialId} {\n      allow read: if isCampStaff();\n      // admin: 모든 자료 생성/수정/삭제\n      // 캠프 스태프: 본인(userId) 자료만 생성/수정/삭제\n      allow create: if (\n        isAdmin() ||\n        (isCampStaff() && request.resource.data.userId == request.auth.uid)\n      );\n      allow update: if (\n        isAdmin() ||\n        (isCampStaff() && resource.data.userId == request.auth.uid)\n      );\n      allow delete: if (\n        isAdmin() ||\n        (isCampStaff() && resource.data.userId == request.auth.uid)\n      );\n\n      // 서브컬렉션: sections\n      // 부모 lessonMaterial의 소유자이거나 admin만 CRUD 가능\n      match /sections/{sectionId} {\n        allow read: if isCampStaff();\n        allow create, update: if (\n          isAdmin() ||\n          isCampStaff()\n        );\n        allow delete: if (\n          isAdmin() ||\n          isCampStaff()\n        );\n      }\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // lessonMaterialTemplates 컬렉션 (수업 자료 템플릿)\n    // 역할: admin(전체), 캠프 스태프(읽기)\n    // ──────────────────────────────────────────────────────────────\n    match /lessonMaterialTemplates/{templateId} {\n      allow read: if isCampStaff();\n      allow create, update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // interviewSettings 컬렉션 (면접 설정/링크)\n    // 역할: admin(전체), 인증 사용자(읽기)\n    // ──────────────────────────────────────────────────────────────\n    match /interviewSettings/{settingId} {\n      allow read: if isAuthenticated();\n      allow create, update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // appConfig 컬렉션 (앱 전역 설정)\n    // 역할: admin(전체), 인증 사용자(읽기) - 버전 체크 등\n    // ──────────────────────────────────────────────────────────────\n    match /appConfig/{configId} {\n      // 앱 버전 체크는 미인증 상태에서도 필요할 수 있음\n      allow read: if true;\n      allow create, update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // campHomeMessages 컬렉션 (캠프별 홈 메시지)\n    // 역할: admin(전체), 인증 사용자(읽기)\n    // ──────────────────────────────────────────────────────────────\n    match /campHomeMessages/{campCode} {\n      allow read: if isAuthenticated();\n      allow create, update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // appSettings 컬렉션 (앱 전역 설정 — 캠프·기수와 무관)\n    // 역할: 로그인 사용자(읽기), admin(전체 CRUD)\n    // 용도: eslBooks (학년별 ESL 교재 리스트, L-Code → 교재 3권)\n    // ──────────────────────────────────────────────────────────────\n    match /appSettings/{docId} {\n      allow read: if isAuthenticated();\n      allow create, update, delete: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // campSettings 컬렉션 (캠프별 설정)\n    // 역할: admin(전체 CRUD), 캠프 스태프(읽기)\n    // 용도: 임시데이터 on/off 설정 (useTemporaryData), sheetColumnMap\n    // ──────────────────────────────────────────────────────────────\n    match /campSettings/{campCode} {\n      allow read: if isCampStaff();\n      allow create, update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // campTimetables 컬렉션 (앱 내부 시간표 — 캠프 × 그룹 × 일과 유형)\n    // 역할: 캠프 스태프(읽기), admin(전체 CRUD)\n    // 담임 이름은 저장하지 않고 classes[].classCode 로 users 에서 조인한다.\n    // ──────────────────────────────────────────────────────────────\n    match /campTimetables/{timetableId} {\n      allow read: if isCampStaff();\n      allow create, update, delete: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // stSheetFieldConfig 컬렉션 (캠프 타입별 동적 필드 설정)\n    // 역할: admin(전체 CRUD), 캠프 스태프(읽기)\n    // 용도: 학생 상세 화면의 섹션·필드 구성 (관리자 대시보드에서 설정)\n    // ──────────────────────────────────────────────────────────────\n    match /stSheetFieldConfig/{campType} {\n      allow read: if isCampStaff();\n      allow create, update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // interviewDates 컬렉션 (면접 일정별 녹화 URL 등)\n    // 역할: admin(전체 CRUD), 인증 사용자(읽기)\n    // ──────────────────────────────────────────────────────────────\n    match /interviewDates/{dateId} {\n      allow read: if isAuthenticated();\n      allow create, update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // interviewScripts 컬렉션 (면접 진행자 스크립트)\n    // 역할: admin(전체 CRUD), 인증 사용자(읽기)\n    // ──────────────────────────────────────────────────────────────\n    match /interviewScripts/{scriptId} {\n      allow read: if isAuthenticated();\n      allow create, update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // userEvaluationSummaries 컬렉션 (사용자별 평가 요약)\n    // 역할: admin(전체 CRUD)\n    // 평가 생성/삭제 시 EvaluationService가 자동으로 upsert/delete\n    // ──────────────────────────────────────────────────────────────\n    match /userEvaluationSummaries/{userId} {\n      allow read: if isAdmin();\n      allow create, update: if isAdmin();\n      allow delete: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // userLocations 컬렉션 (실시간 위치 공유)\n    // 역할: 캠프 스태프끼리 실시간 위치 공유 (토글 ON 시)\n    // 문서 ID: {campCode}_{userId} 복합 키\n    // ──────────────────────────────────────────────────────────────\n    match /userLocations/{locationId} {\n      // 로그인한 모든 사용자(temp 포함) 읽기 가능\n      allow read: if isAuthenticated();\n      // 본인 문서만 생성/수정 가능\n      allow create, update: if isAuthenticated()\n        && request.resource.data.userId == request.auth.uid\n        && request.resource.data.isSharing is bool\n        && request.resource.data.lat is number\n        && request.resource.data.lng is number;\n      // 본인 문서만 삭제 가능\n      allow delete: if isAuthenticated()\n        && resource.data.userId == request.auth.uid;\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // shareTokens 컬렉션 (지원자 공유 토큰)\n    // 역할: 클라이언트 직접 접근 금지 (서버/Admin SDK 전용)\n    // 주의: cleanup-expired API route는 반드시 Admin SDK를 사용해야 함\n    //       (client SDK로 접근 시 이 규칙에 의해 Permission Denied 발생)\n    // ──────────────────────────────────────────────────────────────\n    match /shareTokens/{tokenId} {\n      allow read, write: if false;\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // auditLogs 컬렉션 (감사 로그)\n    // 역할: admin(읽기), 쓰기는 서버 전용\n    // ──────────────────────────────────────────────────────────────\n    match /auditLogs/{logId} {\n      allow read: if isAdmin();\n      allow write: if false;\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // posts 컬렉션 (게시판)\n    //\n    // [접근 설계]\n    // - 작성/읽기 권한: active 역할(mentor, foreign, admin)만 허용\n    //   temp 역할(mentor_temp, foreign_temp)은 업무코드 없이 게시판 불가\n    // - scope='dev': 작성자 본인 + admin만 읽기 가능\n    // - scope 나머지(all/camp/group): active 캠프 스태프 전체 읽기\n    //   (camp/group 범위 필터링은 클라이언트 쿼리에서 jobCodeId/groupId로 처리)\n    //\n    // [update 분리 설계]\n    // - 좋아요 토글(likedBy, likeCount): 본인이 아닌 active 유저도 가능\n    // - commentCount 증감: 댓글 생성/삭제 시 서비스에서 처리 → active 유저 허용\n    // - 내용 수정(content, imageUrls): 작성자 본인 + 핵심 필드 불변 보장\n    // ──────────────────────────────────────────────────────────────\n    match /posts/{postId} {\n      // dev 게시글: 본인 또는 admin만 읽기\n      // 나머지 scope: active 캠프 스태프 전체 읽기\n      allow read: if (\n        isActiveUser() && (\n          resource.data.scope != 'dev' ||\n          isAdmin() ||\n          resource.data.authorId == request.auth.uid\n        )\n      );\n\n      // 새 게시글 작성: active 캠프 스태프 + 본인 명의\n      allow create: if (\n        isActiveUser() &&\n        request.resource.data.authorId == request.auth.uid &&\n        request.resource.data.keys().hasAll([\n          'scope', 'authorId', 'authorName',\n          'content', 'imageUrls',\n          'likeCount', 'likedBy', 'commentCount',\n          'createdAt', 'updatedAt'\n        ]) &&\n        request.resource.data.scope in ['all', 'camp', 'group', 'dev'] &&\n        request.resource.data.content is string &&\n        request.resource.data.content.size() <= 5000 &&\n        request.resource.data.likeCount == 0 &&\n        request.resource.data.commentCount == 0\n      );\n\n      // 좋아요 토글 또는 commentCount 증감:\n      // active 유저라면 likedBy/likeCount/commentCount/updatedAt 만 변경 허용\n      allow update: if (\n        isActiveUser() &&\n        request.resource.data.diff(resource.data).affectedKeys()\n          .hasOnly(['likedBy', 'likeCount', 'commentCount', 'updatedAt'])\n      );\n\n      // 게시글 내용 수정: 작성자 본인만, 핵심 필드 불변\n      allow update: if (\n        isActiveUser() &&\n        resource.data.authorId == request.auth.uid &&\n        fieldUnchanged('authorId') &&\n        fieldUnchanged('scope') &&\n        fieldUnchanged('jobCodeId') &&\n        fieldUnchanged('groupId') &&\n        fieldUnchanged('likedBy') &&\n        fieldUnchanged('likeCount') &&\n        fieldUnchanged('commentCount') &&\n        request.resource.data.content is string &&\n        request.resource.data.content.size() <= 5000\n      );\n\n      // 게시글 삭제: 작성자 본인 또는 admin\n      allow delete: if (\n        isAdmin() ||\n        (isActiveUser() && resource.data.authorId == request.auth.uid)\n      );\n\n      // 댓글 서브컬렉션\n      match /comments/{commentId} {\n        // dev 게시글 댓글: 본인 또는 admin만\n        // 나머지: active 캠프 스태프 전체\n        allow read: if (\n          isActiveUser() && (\n            get(/databases/$(database)/documents/posts/$(postId)).data.scope != 'dev' ||\n            isAdmin() ||\n            resource.data.authorId == request.auth.uid\n          )\n        );\n\n        allow create: if (\n          isActiveUser() &&\n          request.resource.data.authorId == request.auth.uid &&\n          request.resource.data.keys().hasAll([\n            'parentId', 'authorId', 'authorName',\n            'content', 'createdAt', 'updatedAt'\n          ]) &&\n          request.resource.data.content is string &&\n          request.resource.data.content.size() <= 1000\n        );\n\n        // 댓글 수정 / soft delete: 작성자 본인만, 핵심 필드 불변\n        allow update: if (\n          isActiveUser() &&\n          resource.data.authorId == request.auth.uid &&\n          fieldUnchanged('authorId') &&\n          fieldUnchanged('parentId')\n        );\n\n        // 댓글 삭제: 작성자 본인 또는 admin\n        allow delete: if (\n          isAdmin() ||\n          (isActiveUser() && resource.data.authorId == request.auth.uid)\n        );\n      }\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // patientRecords 컬렉션 (환자 기록)\n    // 역할: 캠프 스태프(읽기/쓰기) — admin, mentor, foreign 모두 허용\n    // 민감한 학생 건강 정보이므로 isCampStaff()로 제한\n    // ──────────────────────────────────────────────────────────────\n    match /patientRecords/{recordId} {\n      // 읽기: 캠프 스태프 전체 (admin, mentor, foreign)\n      allow read: if isCampStaff();\n\n      // 생성: 캠프 스태프 + 필수 필드 검증\n      allow create: if (\n        isCampStaff() &&\n        request.resource.data.keys().hasAll([\n          'campCode', 'studentName', 'types',\n          'symptom', 'progressStatus',\n          'visitDate', 'recordedBy', 'createdAt', 'updatedAt'\n        ]) &&\n        request.resource.data.studentName is string &&\n        request.resource.data.studentName.size() <= 50 &&\n        request.resource.data.symptom is string &&\n        request.resource.data.symptom.size() <= 500\n      );\n\n      // 수정: 캠프 스태프 + 핵심 불변 필드 보호\n      allow update: if (\n        isAdmin() ||\n        (\n          isCampStaff() &&\n          fieldUnchanged('campCode') &&\n          fieldUnchanged('studentId') &&\n          fieldUnchanged('createdAt')\n        )\n      );\n\n      // 삭제: admin 또는 본인이 기록한 것만\n      allow delete: if (\n        isAdmin() ||\n        (isCampStaff() && resource.data.recordedById == request.auth.uid)\n      );\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // 캠프 재고 (inventoryGroups / inventoryItems / inventoryMovements)\n    // 역할: 관리자가 물품·그룹 등록/수정/삭제, 캠프 스태프는 조회 +\n    //       환자 탭 약 복용 기록으로 인한 수량(stocks) 증감·이력 기록만 허용\n    // ──────────────────────────────────────────────────────────────\n    // 품목 마스터 (회사 공통) · 그룹(캠프별) · 그룹 패키지(회사 공통): 관리자만 쓰기\n    match /inventoryItems/{itemId} {\n      allow read: if isCampStaff();\n      allow create, update, delete: if isAdmin();\n    }\n\n    match /inventoryGroups/{groupId} {\n      allow read: if isCampStaff();\n      allow create, update, delete: if isAdmin();\n    }\n\n    match /inventoryPackages/{packageId} {\n      allow read: if isCampStaff();\n      allow create, update, delete: if isAdmin();\n    }\n\n    // 캠프별 수량 (문서 ID = campCode__itemId): 관리자만 직접 쓰기.\n    // 약 복용에 따른 차감/복구는 서버(Cloud Function onPatientRecordWritten)가 원장 기준으로 처리\n    match /inventoryStocks/{stockId} {\n      allow read: if isCampStaff();\n      allow create, update, delete: if isAdmin();\n    }\n\n    // 약 복용 재고 원장 (서버 전용)\n    match /inventoryDoseLedger/{recordId} {\n      allow read: if isAdmin();\n      allow write: if false;\n    }\n\n    // 구매 요청: 캠프 스태프 누구나 올림(본인 명의). 본인은 '요청' 상태일 때만 수정·삭제,\n    // 처리(구매 완료/반려)는 관리자\n    match /supplyRequests/{requestId} {\n      allow read: if isCampStaff();\n      allow create: if (\n        isCampStaff() &&\n        request.resource.data.requesterId == request.auth.uid &&\n        request.resource.data.status == 'requested' &&\n        request.resource.data.forType in ['student', 'mentor', 'camp'] &&\n        request.resource.data.items is list &&\n        !('buyerId' in request.resource.data) && !('done' in request.resource.data) && !('settlements' in request.resource.data)\n      );\n      function supplyOpen(s) { return s in ['requested', 'onhold']; }\n      function supplyChanged() { return request.resource.data.diff(resource.data).affectedKeys(); }\n      allow update: if isAdmin() || (isCampStaff() && (\n        // ① 작성자 — 진행 중일 때 내용 수정\n        (\n          resource.data.requesterId == request.auth.uid &&\n          supplyOpen(resource.data.status) &&\n          supplyChanged().hasOnly(['forType', 'studentId', 'studentName', 'studentClass', 'classMentor', 'store', 'storeEtc', 'items', 'note', 'updatedAt']) &&\n          request.resource.data.forType in ['student', 'mentor', 'camp'] &&\n          request.resource.data.items is list\n        ) ||\n        // ② 누구나 — 댓글 1개 추가 (본인 이름으로)\n        (\n          supplyChanged().hasOnly(['comments', 'updatedAt']) &&\n          request.resource.data.comments is list &&\n          request.resource.data.comments.size() == resource.data.get('comments', []).size() + 1 &&\n          request.resource.data.comments[request.resource.data.comments.size() - 1].uid == request.auth.uid\n        ) ||\n        // ③ 구매 담당(요청별 지정, 없으면 캠프 기본 담당) — 품목별 구매 완료·취소 + 금액·송금 계좌\n        (\n          (\n            resource.data.get('buyerId', null) == request.auth.uid ||\n            (resource.data.get('buyerId', null) == null &&\n              get(/databases/$(database)/documents/supplySettings/$(resource.data.campCode)).data.get('defaultBuyerId', null) == request.auth.uid)\n          ) &&\n          resource.data.status in ['requested', 'onhold', 'purchased'] &&\n          request.resource.data.status in ['requested', 'onhold', 'purchased'] &&\n          resource.data.get('stockApplied', false) != true &&\n          supplyChanged().hasOnly(['done', 'status', 'handledBy', 'handledAt', 'statusNote', 'holdUntil', 'amount', 'updatedAt'])\n        ) ||\n        // ④ 정산 체크 — 학생: 담임이 봉투에서 빼서 전달 / 선생님: 본인 송금 (누가 누르는지는 앱에서 확인)\n        (\n          resource.data.forType in ['student', 'mentor'] &&\n          supplyChanged().hasOnly(['settlements', 'updatedAt'])\n        )\n      ));\n      allow delete: if isAdmin() || (isCampStaff() && resource.data.requesterId == request.auth.uid && resource.data.status in ['requested', 'onhold']);\n    }\n\n    // 캠프별 구매 설정 (기본 구매 담당) — 조회 스태프, 변경 관리자\n    match /supplySettings/{campCode} {\n      allow read: if isCampStaff();\n      allow write: if isAdmin();\n    }\n\n    match /purchaseItems/{purchaseId} {\n      allow read: if isCampStaff();\n      allow create, update, delete: if isAdmin();\n    }\n\n    // 분실물: 모든 캠프 스태프가 등록·조회·상태 변경, 삭제는 등록자 또는 관리자\n    match /lostItems/{lostItemId} {\n      allow read: if isCampStaff();\n      allow create: if (\n        isCampStaff() &&\n        request.resource.data.reportedById == request.auth.uid &&\n        request.resource.data.keys().hasAll(['campCode', 'name', 'foundDate', 'status', 'media', 'reportedBy', 'reportedById', 'createdAt', 'updatedAt'])\n      );\n      allow update: if (\n        isCampStaff() &&\n        fieldUnchanged('campCode') &&\n        fieldUnchanged('reportedById') &&\n        fieldUnchanged('createdAt')\n      );\n      allow delete: if isAdmin() || (isCampStaff() && resource.data.reportedById == request.auth.uid);\n    }\n\n    match /inventoryMovements/{movementId} {\n      allow read: if isCampStaff();\n      // 관리자(입고·조정·실사)만 직접 기록, 약 복용 내역은 서버가 기록\n      allow create: if (\n        isAdmin() &&\n        request.resource.data.keys().hasAll(['campCode', 'itemId', 'groupId', 'delta', 'reason', 'at', 'by']) &&\n        request.resource.data.delta is number\n      );\n      allow update, delete: if isAdmin();\n    }\n\n    // ──────────────────────────────────────────────────────────────\n    // 기본 거부 (명시되지 않은 모든 컬렉션)\n    // ──────────────────────────────────────────────────────────────\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-22T12:01:45.371599Z","metadata":{"services":["cloud.firestore"]}}
