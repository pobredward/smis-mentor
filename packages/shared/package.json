{
  "name": "@smis-mentor/shared",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/types/student": {
      "require": "./dist/types/student.js",
      "types": "./dist/types/student.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "TS_NODE_TRANSPILE_ONLY=1 node --require ts-node/register --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "korean-holidays": "^1.0.0"
  },
  "peerDependencies": {
    "firebase": "^11.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "firebase": "^11.5.0"
  }
}
